# Скопируйте в .env и при необходимости поправьте.
COMPOSE_PROJECT_NAME=finance

# Домены разработки. Все *.localhost резолвятся в 127.0.0.1 без правки /etc/hosts.
APP_DOMAIN=finance.localhost
HTTP_PORT=8088
HTTPS_PORT=8448

MONGO_ROOT_USER=finance
MONGO_ROOT_PASSWORD=finance-local-password
MONGO_SHEETS_DATABASE=finance_sheets
MONGO_HISTORY_DATABASE=finance_history

RABBITMQ_USER=finance
RABBITMQ_PASSWORD=finance-local-password
RABBITMQ_VHOST=finance

# Общий секрет подписи токенов. В продакшене задаётся парой ключей RSA.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

REVERB_APP_ID=finance
REVERB_APP_KEY=finance-local-key
REVERB_APP_SECRET=finance-local-secret
