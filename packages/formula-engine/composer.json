{
    "name": "finance/formula-engine",
    "description": "Движок формул электронной таблицы: разбор, вычисление, зависимости, порядок пересчёта",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "brick/math": "^1.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Finance\\FormulaEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Finance\\FormulaEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
