APP_NAME="Таблица финансов"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.finance.localhost:8088

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGO_URI=mongodb://finance:finance-local-password@mongo:27017/?replicaSet=rs0&authSource=admin
MONGO_DATABASE=finance_sheets

# Ключи подписи токенов. Закрытый есть только у этого сервиса, открытый — у сервиса истории.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=60

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=finance
RABBITMQ_PASSWORD=finance-local-password
RABBITMQ_VHOST=finance
RABBITMQ_EXCHANGE=finance.events

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=finance
REVERB_APP_KEY=finance-local-key
REVERB_APP_SECRET=finance-local-secret
REVERB_HOST=sheet-ws
REVERB_PORT=8080
REVERB_SCHEME=http
